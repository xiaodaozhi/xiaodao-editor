{
  "name": "xiaodao-editor",
  "version": "0.1.23",
  "description": "Notion-style block editor for Vue 3 + TypeScript. Ships as a single zero-runtime-dependency package: a framework-agnostic core plus a Vue view layer. Keep developing!",
  "type": "module",
  "license": "MIT",
  "homepage": "https://xiaodaozhi.com/xiaodao-editor.html",
  "keywords": [
    "vue",
    "vue3",
    "vue-component",
    "block-editor",
    "notion",
    "editor",
    "rich-text",
    "text-editor",
    "wysiwyg",
    "markdown",
    "content-editor",
    "block",
    "note",
    "块编辑器",
    "富文本编辑器",
    "笔记编辑器",
    "内容编辑",
    "模块化编辑器"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/block-editor.umd.cjs",
  "module": "./dist/block-editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/block-editor.js",
      "require": "./dist/block-editor.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:demo": "vue-tsc --noEmit && vite build --mode demo",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .ts,.vue,.js --fix",
    "lint:check": "eslint . --ext .ts,.vue,.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"playground/**/*.{ts,vue}\"",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.12",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^2.2.12"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaodaozhi/xiaodao-editor.git"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
      "glob@>=9.0.0 <=14.0.1": "^14.0.2"
    }
  },
  "packageManager": "pnpm@10.29.2+sha512.bef43fa759d91fd2da4b319a5a0d13ef7a45bb985a3d7342058470f9d2051a3ba8674e629672654686ef9443ad13a82da2beb9eeb3e0221c87b8154fff9d74b8"
}
